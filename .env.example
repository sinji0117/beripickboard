# 복사해서 server/.env 로 사용 (커밋 금지)
APP_ENV=local
APP_ADDR=127.0.0.1:8080
DATABASE_URL=mysql://beripick:beripick@127.0.0.1:3306/beripick
G5_TABLE_PREFIX=g5_
REDIS_URL=redis://127.0.0.1:6379
DATA_PATH=../.local/data
JWT_SECRET=change-me-32bytes-min          # 운영은 32바이트 이상 무작위 필수
APP_TZ_OFFSET_HOURS=9                     # g5 기본 Asia/Seoul
# 로그인 시 약한 해시(PASSWORD(), sha1)를 g5 sha256 형식으로 재저장.
# 공존 중인 PHP 사이트가 G5_STRING_ENCRYPT_FUNCTION='create_hash' 일 때만 true
G5_REHASH_ON_LOGIN=false
TRUST_PROXY=false                         # 리버스 프록시 뒤면 true (X-Forwarded-For 사용)
LICENSE_PUBLIC_KEY=
CORS_ORIGIN=http://localhost:5173
RUST_LOG=info,bp_server=debug
